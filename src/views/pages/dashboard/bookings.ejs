<div class="container">
    <div class="page-header">
        <h1>My Bookings</h1>
        <p>View and manage your property appointments</p>
    </div>
    
    <% if (bookings && bookings.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <% bookings.forEach(booking => { %>
                <div style="background: white; padding: 1rem 1.5rem; border-radius: var(--radius); border: 1px solid rgba(31, 41, 55, 0.04); display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
                    <div style="width: 80px; height: 80px; border-radius: 8px; overflow: hidden; flex-shrink: 0;">
                        <img src="<%= booking.image || 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=200&q=80' %>" alt="<%= booking.property_title %>" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <div style="flex: 1;">
                        <h3><%= booking.property_title %></h3>
                        <p style="color: var(--text-light);"><i class="fas fa-calendar"></i> <%= booking.date %></p>
                        <p style="color: var(--text-light);"><i class="fas fa-clock"></i> <%= booking.time %></p>
                        <span class="booking-status status-<%= booking.status %>"><%= booking.status %></span>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <p class="no-results" style="text-align: center; padding: 2rem;">You don't have any bookings yet.</p>
    <% } %>
</div>
