<div class="container">
    <div class="page-header">
        <h1>Facility Management</h1>
        <p>Keeping your properties in perfect condition</p>
    </div>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; max-width: 1000px; margin: 0 auto;">
        <div style="background: white; padding: 2rem; text-align: center; border-radius: var(--radius); border: 1px solid rgba(31, 41, 55, 0.04); box-shadow: var(--shadow);">
            <i class="fas fa-wrench" style="font-size: 2.5rem; color: var(--copper);"></i>
            <h3>Building Maintenance</h3>
            <p style="color: var(--text-light);">Regular maintenance and repairs</p>
        </div>
        <div style="background: white; padding: 2rem; text-align: center; border-radius: var(--radius); border: 1px solid rgba(31, 41, 55, 0.04); box-shadow: var(--shadow);">
            <i class="fas fa-broom" style="font-size: 2.5rem; color: var(--copper);"></i>
            <h3>Cleaning Services</h3>
            <p style="color: var(--text-light);">Professional cleaning solutions</p>
        </div>
        <div style="background: white; padding: 2rem; text-align: center; border-radius: var(--radius); border: 1px solid rgba(31, 41, 55, 0.04); box-shadow: var(--shadow);">
            <i class="fas fa-shield-alt" style="font-size: 2.5rem; color: var(--copper);"></i>
            <h3>Security Management</h3>
            <p style="color: var(--text-light);">Protecting your property</p>
        </div>
        <div style="background: white; padding: 2rem; text-align: center; border-radius: var(--radius); border: 1px solid rgba(31, 41, 55, 0.04); box-shadow: var(--shadow);">
            <i class="fas fa-snowflake" style="font-size: 2.5rem; color: var(--copper);"></i>
            <h3>HVAC Services</h3>
            <p style="color: var(--text-light);">Heating, ventilation, and cooling</p>
        </div>
    </div>
</div>
