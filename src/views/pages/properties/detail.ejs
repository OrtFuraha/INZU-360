<div class="container">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding: 2rem 0;">
        <div>
            <div style="border-radius: var(--radius); overflow: hidden; margin-bottom: 1rem;">
                <img src="<%= images && images.length > 0 ? images[0].url : 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=1200&q=80' %>" alt="<%= property.title %>" style="width: 100%; height: 400px; object-fit: cover;">
            </div>
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem;">
                <% if (images && images.length > 0) { %>
                    <% images.slice(0, 4).forEach(image => { %>
                        <img src="<%= image.url %>" alt="Property image" style="width: 100%; height: 80px; object-fit: cover; border-radius: 8px; cursor: pointer;">
                    <% }); %>
                <% } %>
            </div>
        </div>
        
        <div>
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1.5rem;">
                <h1><%= property.title %></h1>
                <div style="font-size: 2rem; font-weight: 700; color: var(--copper);"><%= property.currency || 'RWF' %> <%= property.price ? property.price.toLocaleString() : '0' %></div>
            </div>
            
            <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; padding: 1rem 0; border-top: 1px solid rgba(31, 41, 55, 0.06); border-bottom: 1px solid rgba(31, 41, 55, 0.06); margin-bottom: 1.5rem;">
                <span><i class="fas fa-bed" style="color: var(--copper);"></i> <%= property.bedrooms || 0 %> Beds</span>
                <span><i class="fas fa-bath" style="color: var(--copper);"></i> <%= property.bathrooms || 0 %> Baths</span>
                <span><i class="fas fa-expand" style="color: var(--copper);"></i> <%= property.area || 0 %> m²</span>
                <span><i class="fas fa-map-marker-alt" style="color: var(--copper);"></i> <%= property.address || property.city || 'Kigali, Rwanda' %></span>
            </div>
            
            <div style="margin: 1.5rem 0;">
                <h3>Description</h3>
                <p><%= property.description || 'This beautiful property is available for viewing. Contact us for more information.' %></p>
            </div>
            
            <% if (amenities && amenities.length > 0) { %>
                <div style="margin: 1.5rem 0;">
                    <h3>Amenities</h3>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                        <% amenities.forEach(amenity => { %>
                            <span style="background: var(--ivory); padding: 0.3rem 1rem; border-radius: 20px; font-size: 0.85rem;"><%= amenity %></span>
                        <% }); %>
                    </div>
                </div>
            <% } %>
            
            <% if (property.has_virtual_tour) { %>
                <div style="margin: 1.5rem 0;">
                    <a href="/virtual-tour/<%= property.id %>" class="btn btn-secondary btn-lg">
                        <i class="fas fa-vr-cardboard"></i> Start Virtual Tour
                    </a>
                </div>
            <% } %>
            
            <div style="background: var(--ivory); padding: 1.5rem; border-radius: var(--radius); margin: 1.5rem 0;">
                <h3>Property Owner</h3>
                <div>
                    <strong><%= property.owner_name || 'INZU360 Owner' %></strong>
                    <p><i class="fas fa-envelope" style="color: var(--copper); width: 20px;"></i> <%= property.owner_email || 'info@inzu360.com' %></p>
                    <p><i class="fas fa-phone" style="color: var(--copper); width: 20px;"></i> <%= property.owner_phone || '+250 788 123 456' %></p>
                </div>
            </div>
            
            <div style="display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap;">
                <a href="#" class="btn btn-primary">Book Viewing</a>
                <a href="#" class="btn btn-outline">Save Property</a>
                <a href="#" class="btn btn-outline"><i class="fas fa-share-alt"></i> Share</a>
            </div>
        </div>
    </div>
    
    <% if (relatedProperties && relatedProperties.length > 0) { %>
        <div style="padding: 3rem 0; border-top: 1px solid rgba(31, 41, 55, 0.06);">
            <h2 style="margin-bottom: 1.5rem;">Related Properties</h2>
            <div class="property-grid">
                <% relatedProperties.forEach(property => { %>
                    <div class="property-card">
                        <div class="property-image">
                            <img src="<%= property.image || 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&q=80' %>" alt="<%= property.title %>">
                        </div>
                        <div class="property-info">
                            <h3><a href="/properties/<%= property.id %>"><%= property.title %></a></h3>
                            <div class="property-footer">
                                <span class="property-price"><%= property.currency || 'RWF' %> <%= property.price ? property.price.toLocaleString() : '0' %></span>
                                <a href="/properties/<%= property.id %>" class="btn btn-secondary btn-sm">View</a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    <% } %>
</div>
