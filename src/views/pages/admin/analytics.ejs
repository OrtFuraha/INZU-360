<div class="container">
    <div class="page-header">
        <h1>Analytics</h1>
        <p>Platform analytics and insights</p>
    </div>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        <div style="background: white; padding: 1.5rem; border-radius: var(--radius); text-align: center; box-shadow: var(--shadow);">
            <div style="font-size: 2rem; font-weight: 700; color: var(--primary);"><%= analytics.totalUsers ? analytics.totalUsers.count : 0 %></div>
            <div style="color: var(--text-light);">Total Users</div>
        </div>
        <div style="background: white; padding: 1.5rem; border-radius: var(--radius); text-align: center; box-shadow: var(--shadow);">
            <div style="font-size: 2rem; font-weight: 700; color: var(--primary);"><%= analytics.totalProperties ? analytics.totalProperties.count : 0 %></div>
            <div style="color: var(--text-light);">Total Properties</div>
        </div>
        <div style="background: white; padding: 1.5rem; border-radius: var(--radius); text-align: center; box-shadow: var(--shadow);">
            <div style="font-size: 2rem; font-weight: 700; color: var(--primary);"><%= analytics.totalBookings ? analytics.totalBookings.count : 0 %></div>
            <div style="color: var(--text-light);">Total Bookings</div>
        </div>
        <div style="background: white; padding: 1.5rem; border-radius: var(--radius); text-align: center; box-shadow: var(--shadow);">
            <div style="font-size: 2rem; font-weight: 700; color: var(--primary);"><%= analytics.totalViews ? analytics.totalViews.total : 0 %></div>
            <div style="color: var(--text-light);">Total Views</div>
        </div>
    </div>
    
    <div style="background: white; padding: 2rem; border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 2rem;">
        <h3>Properties by Type</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem; margin-top: 1rem;">
            <% if (analytics.propertiesByType && analytics.propertiesByType.length > 0) { %>
                <% analytics.propertiesByType.forEach(type => { %>
                    <div style="background: var(--ivory); padding: 1rem; border-radius: var(--radius); text-align: center;">
                        <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary);"><%= type.count %></div>
                        <div style="color: var(--text-light);"><%= type.property_type || 'Unknown' %></div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
    
    <div style="background: white; padding: 2rem; border-radius: var(--radius); box-shadow: var(--shadow);">
        <h3>Recent Activity</h3>
        <div style="margin-top: 1rem;">
            <% if (analytics.recentActivity && analytics.recentActivity.length > 0) { %>
                <% analytics.recentActivity.forEach(activity => { %>
                    <div style="padding: 0.5rem 0; border-bottom: 1px solid rgba(31, 41, 55, 0.06); display: flex; justify-content: space-between;">
                        <span><%= activity.type === 'user' ? '👤' : '🏠' %> <%= activity.title %></span>
                        <span style="color: var(--text-light); font-size: 0.85rem;"><%= new Date(activity.created_at).toLocaleDateString() %></span>
                    </div>
                <% }); %>
            <% } else { %>
                <p style="color: var(--text-light);">No recent activity</p>
            <% } %>
        </div>
    </div>
</div>
