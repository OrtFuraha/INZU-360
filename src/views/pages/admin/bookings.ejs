<div class="container">
    <div class="page-header">
        <h1>Manage Bookings</h1>
        <p>View and manage all property bookings</p>
    </div>
    
    <div style="background: white; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow);">
        <table style="width: 100%; border-collapse: collapse;">
            <thead style="background: var(--primary); color: white;">
                <tr>
                    <th style="padding: 0.8rem; text-align: left;">ID</th>
                    <th style="padding: 0.8rem; text-align: left;">Property</th>
                    <th style="padding: 0.8rem; text-align: left;">User</th>
                    <th style="padding: 0.8rem; text-align: left;">Date</th>
                    <th style="padding: 0.8rem; text-align: left;">Status</th>
                    <th style="padding: 0.8rem; text-align: left;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% bookings.forEach(booking => { %>
                    <tr style="border-bottom: 1px solid rgba(31, 41, 55, 0.06);">
                        <td style="padding: 0.8rem;"><%= booking.id %></td>
                        <td style="padding: 0.8rem;"><%= booking.property_title %></td>
                        <td style="padding: 0.8rem;"><%= booking.user_name %></td>
                        <td style="padding: 0.8rem;"><%= booking.date %> at <%= booking.time %></td>
                        <td style="padding: 0.8rem;">
                            <form action="/admin/bookings/<%= booking.id %>/status" method="POST" style="display: inline;">
                                <select name="status" onchange="this.form.submit()" style="padding: 0.3rem 0.5rem; border-radius: 4px; border: 1px solid #ddd;">
                                    <option value="pending" <%= booking.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="approved" <%= booking.status === 'approved' ? 'selected' : '' %>>Approved</option>
                                    <option value="completed" <%= booking.status === 'completed' ? 'selected' : '' %>>Completed</option>
                                    <option value="cancelled" <%= booking.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                            </form>
                        </td>
                        <td style="padding: 0.8rem;">
                            <span style="background: var(--ivory); padding: 0.2rem 0.8rem; border-radius: 20px; font-size: 0.8rem;"><%= booking.booking_type %></span>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>
