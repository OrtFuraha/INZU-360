<div class="container">
    <div class="page-header">
        <h1>Add Matterport Tour</h1>
        <p>Paste a Matterport share link or embed code</p>
    </div>

    <div style="max-width: 800px; margin: 0 auto; background: white; padding: 2rem; border-radius: var(--radius); box-shadow: var(--shadow);">
        <form action="/admin/matterport/create" method="POST" id="matterportForm">

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.4rem;">Property *</label>
                <select name="property_id" required style="width: 100%; padding: 0.8rem; border: 1px solid #E5E7EB; border-radius: 8px;">
                    <option value="">Select a property…</option>
                    <% properties.forEach(p => { %>
                        <option value="<%= p.id %>"><%= p.title %></option>
                    <% }); %>
                </select>
            </div>

            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.4rem;">
                    Matterport Share Link or Embed Code *
                </label>
                <textarea name="matterport_input" id="matterportInput" rows="4" required
                    placeholder="https://my.matterport.com/show/?m=SxQL3iGyoDo&#10;or paste the full <iframe> embed code"
                    style="width: 100%; padding: 0.8rem; border: 1px solid #E5E7EB; border-radius: 8px; font-family: monospace; font-size: 0.9rem;"></textarea>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <button type="button" id="detectBtn" class="btn btn-secondary">
                    <i class="fas fa-search"></i> Detect Matterport Tour
                </button>
                <span id="detectStatus" style="margin-left: 1rem;"></span>
            </div>

            <div id="previewBox" style="display:none; margin-bottom: 1.5rem; border: 1px solid rgba(31,41,55,0.08); border-radius: var(--radius); overflow: hidden;">
                <div style="background: var(--ivory); padding: 0.8rem 1rem; border-bottom: 1px solid rgba(31,41,55,0.08); font-size: 0.9rem;">
                    Model ID: <strong id="previewId" style="font-family: monospace;"></strong>
                </div>
                <iframe id="previewFrame" width="100%" height="380" frameborder="0" allowfullscreen style="display:block;"></iframe>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; background: var(--ivory); padding: 1rem; border-radius: 8px; cursor: pointer;">
                    <input type="checkbox" name="is_published" value="1" checked>
                    <span><strong>Published</strong><br><small style="color: var(--text-light);">Visible on the public site</small></span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; background: var(--ivory); padding: 1rem; border-radius: 8px; cursor: pointer;">
                    <input type="checkbox" name="featured_on_homepage" value="1">
                    <span><strong>Feature on Homepage</strong><br><small style="color: var(--text-light);">Show in featured 3D section</small></span>
                </label>
            </div>

            <div style="display: flex; gap: 1rem;">
                <button type="submit" class="btn btn-primary">Save Matterport Tour</button>
                <a href="/admin/matterport" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
(function() {
    const input = document.getElementById('matterportInput');
    const btn = document.getElementById('detectBtn');
    const status = document.getElementById('detectStatus');
    const box = document.getElementById('previewBox');
    const frame = document.getElementById('previewFrame');
    const idOut = document.getElementById('previewId');

    function setStatus(html, color) {
        status.innerHTML = html;
        status.style.color = color || '';
    }

    btn.addEventListener('click', async () => {
        const value = input.value.trim();
        if (!value) {
            setStatus('Please paste a Matterport link or embed code.', '#dc3545');
            box.style.display = 'none';
            return;
        }
        setStatus('Detecting…', 'var(--text-light)');

        try {
            const resp = await fetch('/admin/matterport/detect', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ input: value })
            });
            const data = await resp.json();

            if (!data.ok) {
                setStatus('✗ ' + (data.error || 'Unable to detect a valid Matterport tour.'), '#dc3545');
                box.style.display = 'none';
                return;
            }

            setStatus('✓ Matterport tour detected', 'var(--emerald)');
            idOut.textContent = data.modelId;
            frame.src = data.embedUrl;
            box.style.display = 'block';
        } catch (err) {
            setStatus('✗ Unable to detect. Please try again.', '#dc3545');
            box.style.display = 'none';
        }
    });
})();
</script>
