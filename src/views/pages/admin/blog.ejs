<div class="container">
    <div class="page-header">
        <h1>Manage Blog</h1>
        <p>Create and manage blog posts</p>
    </div>
    
    <div style="background: white; padding: 2rem; border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 2rem;">
        <h3>Create New Post</h3>
        <form action="/admin/blog/create" method="POST">
            <div style="margin-bottom: 1rem;">
                <input type="text" name="title" placeholder="Post Title" required style="width: 100%; padding: 0.8rem; border: 1px solid #E5E7EB; border-radius: 8px;">
            </div>
            <div style="margin-bottom: 1rem;">
                <input type="text" name="slug" placeholder="URL Slug (e.g., my-post-title)" required style="width: 100%; padding: 0.8rem; border: 1px solid #E5E7EB; border-radius: 8px;">
            </div>
            <div style="margin-bottom: 1rem;">
                <input type="text" name="excerpt" placeholder="Short Excerpt" style="width: 100%; padding: 0.8rem; border: 1px solid #E5E7EB; border-radius: 8px;">
            </div>
            <div style="margin-bottom: 1rem;">
                <textarea name="content" placeholder="Full Content" rows="6" required style="width: 100%; padding: 0.8rem; border: 1px solid #E5E7EB; border-radius: 8px;"></textarea>
            </div>
            <div style="margin-bottom: 1rem;">
                <select name="status" style="width: 100%; padding: 0.8rem; border: 1px solid #E5E7EB; border-radius: 8px;">
                    <option value="draft">Draft</option>
                    <option value="published">Published</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Create Post</button>
        </form>
    </div>
    
    <div style="background: white; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow);">
        <table style="width: 100%; border-collapse: collapse;">
            <thead style="background: var(--primary); color: white;">
                <tr>
                    <th style="padding: 0.8rem; text-align: left;">ID</th>
                    <th style="padding: 0.8rem; text-align: left;">Title</th>
                    <th style="padding: 0.8rem; text-align: left;">Status</th>
                    <th style="padding: 0.8rem; text-align: left;">Views</th>
                    <th style="padding: 0.8rem; text-align: left;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% posts.forEach(post => { %>
                    <tr style="border-bottom: 1px solid rgba(31, 41, 55, 0.06);">
                        <td style="padding: 0.8rem;"><%= post.id %></td>
                        <td style="padding: 0.8rem;"><%= post.title %></td>
                        <td style="padding: 0.8rem;">
                            <span style="background: <%= post.status === 'published' ? 'var(--emerald)' : 'var(--copper)' %>; color: white; padding: 0.2rem 0.8rem; border-radius: 20px; font-size: 0.8rem;"><%= post.status %></span>
                        </td>
                        <td style="padding: 0.8rem;"><%= post.views || 0 %></td>
                        <td style="padding: 0.8rem;">
                            <form action="/admin/blog/<%= post.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Delete this post?');">
                                <button type="submit" class="btn btn-sm" style="background: #dc3545; color: white; border: none; padding: 0.3rem 0.8rem; border-radius: 4px; cursor: pointer;">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>
