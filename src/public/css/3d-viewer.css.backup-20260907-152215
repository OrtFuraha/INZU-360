
/* Scene Strip */
#scene-strip {
    position: absolute;
    bottom: 50px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
    background: rgba(0,0,0,0.7);
    padding: 10px 16px;
    border-radius: 12px;
    backdrop-filter: blur(10px);
    overflow-x: auto;
    max-width: 80%;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
}

#scene-strip::-webkit-scrollbar {
    height: 4px;
}

#scene-strip::-webkit-scrollbar-thumb {
    background: #B87333;
    border-radius: 2px;
}

.scene-strip-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.3s ease;
    min-width: 60px;
    opacity: 0.6;
    background: rgba(255,255,255,0.05);
}

.scene-strip-item:hover {
    opacity: 0.8;
    background: rgba(255,255,255,0.1);
}

.scene-strip-item.active {
    opacity: 1;
    background: rgba(184, 115, 51, 0.3);
    box-shadow: 0 0 20px rgba(184, 115, 51, 0.2);
}

.scene-thumb {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background-size: cover;
    background-position: center;
    background-color: #2a2a3a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: rgba(255,255,255,0.3);
}

.scene-name {
    font-size: 10px;
    color: rgba(255,255,255,0.8);
    text-align: center;
    max-width: 60px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Floor Plan */
#floorplan-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
    background: rgba(0,0,0,0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 20px 100px;
}

.floorplan-wrapper {
    position: relative;
    max-width: 90%;
    max-height: 80%;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
}

.floorplan-wrapper img {
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
}

.floorplan-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 12px 20px;
    background: linear-gradient(transparent, rgba(0,0,0,0.7));
    color: white;
    font-size: 14px;
    font-weight: 500;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    #scene-strip {
        bottom: 40px;
        padding: 8px 12px;
        max-width: 90%;
        gap: 4px;
    }
    
    .scene-strip-item {
        min-width: 50px;
        padding: 4px 8px;
    }
    
    .scene-thumb {
        width: 32px;
        height: 32px;
    }
    
    .scene-name {
        font-size: 8px;
    }
    
    #scene-nav {
        bottom: 90px;
    }
    
    #view-mode-toggle {
        bottom: 90px;
    }
}

@media (max-width: 480px) {
    .scene-strip-item {
        min-width: 40px;
    }
    
    .scene-thumb {
        width: 28px;
        height: 28px;
    }
    
    .scene-name {
        display: none;
    }
}
